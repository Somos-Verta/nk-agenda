# Chave de API do projeto Sellflux (Configurações → API). Só é lida no servidor.
SELLFLUX_TOKEN=

# Opcional: id de um usuário com permissão de CRM no projeto, usado como acting_user_id nas rotas /crm/*.
# Necessário se os usuários "Recepção" não tiverem permissão de CRM. Os usuários das unidades entram como participantes.
SELLFLUX_ACTING_USER_ID=

# Senha compartilhada das atendentes (tela de login)
APP_PASSWORD=

# String aleatória longa para assinar o cookie de sessão (ex.: `openssl rand -hex 32`)
SESSION_SECRET=

# Supabase — projeto N8N - RevLab (provisório, tabela nk_unidades). Service role: Dashboard → Settings → API.
SUPABASE_URL=https://iuqccawxtrooqzbdskpk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
